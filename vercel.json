{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/interno/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/3d/(three|RoundedBoxGeometry)-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/calculadora",
      "destination": "/#calculadora",
      "permanent": true
    },
    {
      "source": "/calculadora.html",
      "destination": "/#calculadora",
      "permanent": true
    }
  ]
}
